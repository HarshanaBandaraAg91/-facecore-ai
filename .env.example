# ==============================================================================
# FACECORE AI — Unified Root Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root or copy individual templates
# from backend/.env.example and frontend/.env.example for separated deployments.

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME=FACECORE AI
APP_VERSION=1.0.0-prod
ENVIRONMENT=production
DEBUG=false

# Allowed Cross-Origin Resource Sharing (CORS) origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Ingestion Safeguards & Payload Limits
MAX_UPLOAD_SIZE_BYTES=15728640    # 15 MB
MIN_IMAGE_DIMENSION=48           # 48x48 px hard failure gate
MAX_IMAGE_DIMENSION=4096         # 4096 px maximum dimension
MAX_TOTAL_PIXELS=16777216        # 16 MP decompression bomb ceiling

# Biometric Privacy & Audit Trail Policy
AUDIT_LOGGING_ENABLED=true       # Set to 'false' for 100% zero-persistence audit mode
AUDIT_RETENTION_DAYS=30          # Automatic pruning window for comparison metadata

# Local Storage Paths
DATABASE_PATH=backend/data/facecore.db
WEIGHTS_DIR=backend/app/weights

# Default Decision Threshold Profile ("high_security", "balanced", "high_convenience")
DEFAULT_THRESHOLD_PROFILE=balanced
ADVISORY_MIN_FACE_WIDTH=48

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8001

