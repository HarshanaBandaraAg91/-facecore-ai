# ==============================================================================
# FACECORE AI — Backend Environment Configuration Example
# Copy this file to '.env' and adjust values for your local or cloud environment.
# ==============================================================================

# Application Metadata
APP_NAME=FACECORE AI
APP_VERSION=1.0.0-prod
ENVIRONMENT=production
DEBUG=false

# Security & CORS (Comma-separated allowed client origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# File Upload & Ingestion Safeguards (Step 09.2 Evidence-Based Gates)
MAX_UPLOAD_SIZE_BYTES=15728640    # 15 MB maximum payload ceiling
MIN_IMAGE_DIMENSION=48           # 48x48 px minimum dimension hard gate
MAX_IMAGE_DIMENSION=4096         # 4096 px maximum image dimension
MAX_TOTAL_PIXELS=16777216        # 16 MP decompression bomb cap

# Biometric Privacy & Audit Trail Policy (Step 11 Security Controls)
# If false, disables all SQLite comparison logging for zero audit footprint
AUDIT_LOGGING_ENABLED=true
# Number of days to retain comparison metadata before automated pruning
AUDIT_RETENTION_DAYS=30

# SQLite Persistence Path
DATABASE_PATH=backend/data/facecore.db

# Neural Network Model Weights Directory (OpenCV YuNet + SFace)
WEIGHTS_DIR=backend/app/weights

# Default Decision Threshold Profile ("high_security", "balanced", "high_convenience")
DEFAULT_THRESHOLD_PROFILE=balanced

# Quality Advisory Warning Thresholds
ADVISORY_MIN_FACE_WIDTH=48
