# ==============================================================================
# FACECORE AI — Git Exclusion Configuration (.gitignore)
# ==============================================================================

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
backend/.venv/
*/.venv/

# --- Python Bytecode & Test Caches ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js & Frontend Build Outputs ---
node_modules/
*/node_modules/
frontend/node_modules/
frontend/dist/
.vite/
*/.vite/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment Files & Secrets (Never commit credentials) ---
.env
.env.*
*.env
!.env.example
!*.env.example
frontend/.env
backend/.env

# --- SQLite Database Files & WAL Journals ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db*

# --- Datasets, Benchmark Archives & Raw Evaluation Images ---
backend/data/*
!backend/data/.gitkeep
data/
*.tgz
*.tar.gz
*.tar
*.zip
*.7z
*.rar
*.gz

# --- Temporary Files, Scratch & Uploads ---
tmp/
temp/
scratch/
uploads/
*.tmp
*.bak

# --- Logs & OS Artifacts ---
*.log
logs/
.DS_Store
Thumbs.db
desktop.ini

# --- Release Distribution Directory (Generated Artifacts) ---
release/

# --- Essential Model Files Whitelist ---
# Preserve OpenCV YuNet detector and SFace recognizer weights for out-of-the-box local deployment
!backend/app/weights/face_detection_yunet_2023mar.onnx
!backend/app/weights/face_recognition_sface_2021dec.onnx
